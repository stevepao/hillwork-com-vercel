# PurelyMail SMTP (used by local Node API and Cloudflare Pages Functions)
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-purelymail-password

CONTACT_TO=you@yourdomain.com
CONTACT_FROM=you@yourdomain.com

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# Set the same variable names in Cloudflare Pages → Settings → Environment variables
# (Production and Preview). SMTP_PASS and TURNSTILE_SECRET_KEY should be secrets.
